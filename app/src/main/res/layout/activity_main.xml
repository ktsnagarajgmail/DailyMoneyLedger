<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textColor = "?android:textColorPrimary"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txtCreditView"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="50dp"
        android:layout_marginTop="60dp"
        android:text="..Credits : "
        android:textAlignment="center"
        android:textColor="?android:textColorPrimary"
        android:textSize="20dp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/txtDebitView"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="50dp"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/txtCreditView"
        android:text=" Debits.. : "
        android:textAlignment="center"
        android:textColor="?android:textColorPrimary"
        android:textSize="20dp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/txtABView"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/txtDebitView"
        android:text="Account Balance : "
        android:textAlignment="center"
        android:textColor="?android:textColorPrimary"
        android:textSize="25dp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/txtCreditValue"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="60dp"
        android:layout_toRightOf="@+id/txtCreditView"
        android:textAlignment="center"
        android:text="..."
        android:textColor="?android:textColorPrimary"
        android:textSize="20dp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/txtDebitValue"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:layout_toRightOf="@+id/txtDebitView"
        android:layout_below="@+id/txtCreditValue"
        android:textAlignment="center"
        android:text="..."
        android:textColor="?android:textColorPrimary"
        android:textSize="20dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtABValue"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="30dp"
        android:layout_toRightOf="@+id/txtABView"
        android:layout_below="@+id/txtDebitValue"
        android:textAlignment="center"
        android:text="..."
        android:textColor="?android:textColorPrimary"
        android:textSize="25dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/top5Debits"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtABView"
        android:layout_marginTop="90dp"
        android:layout_centerHorizontal="true"
        android:text="Top 5 Debits"
        android:background="@color/teal_700"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="25dp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/top5Debits"
        android:layout_marginTop="10dp"
        android:layout_alignParentStart="true"
        android:orientation="horizontal"
        android:id="@+id/reportViewLayoutMain"
        android:weightSum="2">

        <TextView
            android:id="@+id/idType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="left"
            android:padding="3dp"
            android:text="Type"
            android:textColor = "?android:textColorPrimary" />


        <!--text view for our course duration-->
        <TextView
            android:id="@+id/idAmount"
            android:layout_width="23dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="left"
            android:padding="3dp"
            android:text="Amount"
            android:textColor = "?android:textColorPrimary" />

        <TextView
            android:id="@+id/idDesc"
            android:layout_width="199dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="left"
            android:padding="3dp"
            android:text="Description"
            android:textColor = "?android:textColorPrimary" />



    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/idRVCoursesMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/reportViewLayoutMain"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:id="@+id/bottom_navigation"
        app:itemBackground="@color/teal_700"
        app:itemIconTint="@drawable/selector"
        app:itemTextColor="@drawable/selector"
        app:menu="@menu/menu_navigation" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="100dp"
        android:clickable="true"
        android:backgroundTint="@color/teal_700"
        android:src="@drawable/baseline_add_circle_outline_24" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap on '+' to add new item"
        android:textSize="15dp"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/bottom_navigation"
        android:layout_marginBottom="160dp"
        android:textColor="@color/teal_700"/>


  <!--  <Button
        android:id="@+id/buttonReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Button"
        android:backgroundTint="@color/teal_700"
        android:layout_marginStart="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="100dp"/>-->


</RelativeLayout>